# LLM API key（必填；不要提交真实 key）
# 多 key 用逗号分隔：DEEPSEEK_API_KEYS=sk-aaa,sk-bbb
DEEPSEEK_API_KEY=sk-xxxx

# 换供应商时改这两个（必须是完整的 /chat/completions URL）
# 详见 docs/llm-providers.md；换完先跑 python scripts/check_llm.py
# MINGLI_LLM_URL=https://api.deepseek.com/chat/completions
# MINGLI_LLM_MODEL=deepseek-chat

# 大小模型路由（默认开启）
# 简单题走 small，跨书比较/多步推理走 large；两档默认同一个 key、同一个 URL。
# 换供应商时两个都改；小模型不是 deepseek* 时，大模型默认跟小模型相同（不猜模型名）。
# MINGLI_ROUTER=on
# MINGLI_TIER_SMALL_MODEL=deepseek-chat
# MINGLI_TIER_LARGE_MODEL=deepseek-v4-pro
# 难度分阈值：>=3 走大模型；调低会多花钱，调高会多降级
# MINGLI_ROUTER_THRESHOLD=3
# 小模型输出不可用时升级（默认开）
# MINGLI_ROUTER_ESCALATE=on
# 小模型拒答时也升级（默认开），但要求检索分够高：检索明明命中了，它还说
# 「语料里没有」，多半是读不懂。分数是 RRF 分，量级 0.08–0.18；实测语料外
# 的题基本不超过 0.10。
# MINGLI_ROUTER_ESCALATE_REFUSAL=on
# MINGLI_ROUTER_REFUSAL_MIN_SCORE=0.10
# 两档的思考模式（只有 deepseek* 会带这两个字段）
# MINGLI_TIER_SMALL_THINKING=disabled
# MINGLI_TIER_LARGE_THINKING=enabled
# MINGLI_TIER_LARGE_EFFORT=high

# 语料目录（可选；默认 <repo>/data）
# MINGLI_DATA_DIR=/path/to/data

# 本地 BGE-M3 权重目录（可选；默认 BAAI/bge-m3）
# MINGLI_MODEL_DIR=/path/to/bge-m3

# 检索吞吐调参（本地编码时才有意义）
# 远程 embed 服务：设了它就不用本地模型，query 编码走 HTTP 批处理
# MINGLI_EMBED_URL=http://127.0.0.1:8100
# query 向量 LRU 条数，0 表示关闭缓存
# MINGLI_QUERY_CACHE=2048
# 每个进程同时编码的 query 数；CPU 机器建议 ≤ 核数/worker 数
# MINGLI_EMBED_CONCURRENCY=4
# torch 线程数；默认 2。设太大 + 并发请求会让核互相抢，吞吐反而下降
# MINGLI_TORCH_THREADS=2
# BM25 实现：fast=倒排索引（默认）；ref=rank_bm25，只用于 A/B 对比
# MINGLI_BM25_IMPL=fast

# 公网 Demo 额度闸门（只对老 Streamlit 版 src/app.py 生效，API 部署不看这两个）
MINGLI_SESSION_LLM_LIMIT=6
MINGLI_DAILY_LLM_LIMIT=300
# API 版的每用户每日额度（Redis 计数，0 = 不启用）。
# 注意它按 X-Anonymous-Id 算，而这个头是浏览器自己给的，改一下就换个人——
# 它防的是「一个人把额度刷爆」，防不住换 IP + 换 id 的脚本。
# MINGLI_USER_DAILY_LIMIT=0

# FastAPI（可选）
# 设置后 /chat /retrieve /trace 都要带 Authorization: Bearer <token>
# MINGLI_API_TOKEN=change-me
# MINGLI_MAX_CONCURRENCY=4
# MINGLI_TRACE_CACHE=200
# 接口文档开关：默认关闭。本地调试想看 /docs 再设 1；线上不要开——
# Nginx 会给每个 /api/ 请求注入 Bearer token，开着等于把带授权的接口摆在公网。
# MINGLI_ENABLE_DOCS=1
# MINGLI_HOST=0.0.0.0
# MINGLI_PORT=8000

# 业务数据库（可选；默认 <repo>/data/app.sqlite3）
# 部署到 Postgres 时改成：postgresql+psycopg://user:pass@host:5432/mingli
# MINGLI_DB_URL=sqlite:///data/app.sqlite3

# docker compose 部署 Postgres 时必填；请改成随机强密码
POSTGRES_PASSWORD=change-me

# MCP server（可选；默认 stdio，本地管道不需要鉴权）
# MCP_TRANSPORT=streamable-http
# MCP_HOST=127.0.0.1
# MCP_PORT=8765
# 设置后 sse / streamable-http 要求 Authorization: Bearer <token>；
# 留空则启动告警但保持无鉴权（此时请只绑 127.0.0.1）
# MINGLI_MCP_TOKEN=change-me
