# DeepSeek API key（必填；不要提交真实 key）
DEEPSEEK_API_KEY=sk-xxxx

# 语料目录（可选；默认 <repo>/data）
# MINGLI_DATA_DIR=/path/to/data

# 本地 BGE-M3 权重目录（可选；默认 BAAI/bge-m3）
# MINGLI_MODEL_DIR=/path/to/bge-m3

# 公网 Demo 额度闸门（只在用服务端 key 时生效）
MINGLI_SESSION_LLM_LIMIT=6
MINGLI_DAILY_LLM_LIMIT=300

# FastAPI（可选）
# 设置后 /chat /retrieve /trace 都要带 Authorization: Bearer <token>
# MINGLI_API_TOKEN=change-me
# MINGLI_MAX_CONCURRENCY=4
# MINGLI_TRACE_CACHE=200
# MINGLI_HOST=0.0.0.0
# MINGLI_PORT=8000

# 业务数据库（可选；默认 <repo>/data/app.sqlite3）
# docker compose 默认把它指到 mingli_state 卷，重建容器不丢数据。
# 部署到 Postgres 时改成：postgresql+psycopg://user:pass@host:5432/mingli
# MINGLI_DB_URL=sqlite:////var/lib/mingli/app.sqlite3

# 评测中台账本（可选；默认 <repo>/data/platform.sqlite3）
# MINGLI_PLATFORM_DB=/var/lib/mingli/platform.sqlite3
