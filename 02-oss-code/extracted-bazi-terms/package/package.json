{
  "name": "bazi-terms",
  "version": "0.1.0",
  "description": "Bilingual (Chinese/English) Bazi & Four Pillars terminology database: Heavenly Stems, Earthly Branches, Ten Gods, Shen Sha, Na Yin, growth stages and interactions. Zero dependencies.",
  "keywords": [
    "bazi",
    "八字",
    "four-pillars",
    "chinese-astrology",
    "terminology",
    "glossary",
    "bilingual",
    "ten-gods",
    "shensha"
  ],
  "license": "MIT",
  "author": {
    "name": "AskingMing",
    "url": "https://askingming.com"
  },
  "homepage": "https://askingming.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/favkit/bazi-kit.git",
    "directory": "packages/bazi-terms"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}